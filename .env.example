# ============================================================
# DocRetriever — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env
#   2. Edit .env with your actual values
#   3. NEVER commit .env to git (already in .gitignore)
# ============================================================

# ── PostgreSQL (matches docker-compose.yml defaults) ─────────────────────────
POSTGRES_USER=docretriever
POSTGRES_PASSWORD=docretriever_pass
POSTGRES_DB=docretriever_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text    # 768-dim, ~274MB
OLLAMA_LLM_MODEL=llama3.2:3b          # generation, ~2GB RAM
# WHY keep_alive=0: unload model from RAM immediately after inference
# This is THE key 8GB RAM management decision in this project
OLLAMA_KEEP_ALIVE=0

# ── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base  # cross-encoder, ~0.3GB
RERANKER_DEVICE=cpu                    # no GPU → always cpu

# ── Retrieval ─────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5
DEFAULT_STRATEGY=simple                # simple | semantic | hybrid | rerank
EMBEDDING_DIM=768

# ── Eval ─────────────────────────────────────────────────────────────────────
EVAL_JUDGE_MODEL=llama3.2:3b          # local judge = free, no API key needed
EVAL_DATASET_PATH=eval/data/qa_pairs.jsonl
EVAL_REPORTS_DIR=eval/reports

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Corpus ───────────────────────────────────────────────────────────────────
CORPUS_DIR=corpus/fastapi_docs

# ── Optional: OpenAI fallback for eval judge ─────────────────────────────────
# Uncomment ONLY if local judge (llama3.2:3b) is inconsistent.
# Use free tier. Document BOTH local + openai scores in eval report.
# OPENAI_API_KEY=sk-...
