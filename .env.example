# ============================================================
# DocRetriever — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env
#   2. Edit .env with your actual values
#   3. NEVER commit .env to git (already in .gitignore)
# ============================================================

# ── PostgreSQL (Render Managed PostgreSQL) ───────────────────────────────────
# For Render: Use the Internal Database URL from your PostgreSQL service
POSTGRES_USER=docretriever
POSTGRES_PASSWORD=docretriever_pass
POSTGRES_DB=docretriever_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Groq Cloud API (Free Tier) ──────────────────────────────────────────────
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.1-8b-instant

# ── Embeddings (sentence-transformers, runs on CPU) ──────────────────────────
EMBED_MODEL=all-MiniLM-L6-v2   # 384-dim, fast on CPU, no API key needed
EMBEDDING_DIM=384

# ── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base  # cross-encoder, ~0.3GB
RERANKER_DEVICE=cpu                    # no GPU → always cpu

# ── Retrieval ─────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5
DEFAULT_STRATEGY=simple                # simple | semantic | hybrid | rerank

# ── Eval ─────────────────────────────────────────────────────────────────────
EVAL_JUDGE_MODEL=llama-3.1-8b-instant
EVAL_DATASET_PATH=eval/data/qa_pairs.jsonl
EVAL_REPORTS_DIR=eval/reports

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Corpus ───────────────────────────────────────────────────────────────────
CORPUS_DIR=corpus/fastapi_docs
